# Copy this file to backend/.env and fill in strong secrets before running.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
JWT_SECRET=replace-with-64-char-random-hex-secret
JWT_EXPIRE_MINUTES=60
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW_SEC=60
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000
DEV_SEED_EMAIL=
DEV_SEED_PASSWORD=

# Email / SMTP Configuration (Optional: for real email OTP delivery)
# For Gmail: Use your Gmail address and 16-character App Password (from myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SENDER_NAME=ParkKaro
